# OPTIONAL: run the world server (mangosd) under systemd, so that "Restart world" in the panel
# brings it back by itself. Edit User/Group and the paths, then:
#   sudo cp deploy/cmangos-world.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now cmangos-world
#
# IMPORTANT: set  Console.Enable = 0  in mangosd.conf. Under systemd there is no keyboard; with the
# console on, mangosd reads "end of input" and shuts down right after the start.
# Commands still work: through the panel's Console page (SOAP).
#
# How it behaves:
#   .server restart / panel "Restart"  -> mangosd exits with code 2   -> systemd starts it again
#   crash                              -> killed by a signal          -> systemd starts it again
#   .server shutdown                   -> exits with code 0           -> stays stopped
#   systemctl stop cmangos-world       -> SIGTERM: saves players and exits
# RestartSec gives the SOAP port time to become free after a restart: if it is still busy, mangosd
# fails to start and systemd simply tries again.

[Unit]
Description=CMaNGOS Classic world server (mangosd)
After=network-online.target mariadb.service mysql.service cmangos-realm.service
Wants=network-online.target

[Service]
Type=simple
User=wow
Group=wow
WorkingDirectory=/home/wow/cmangos/run/bin
ExecStart=/home/wow/cmangos/run/bin/mangosd -c /home/wow/cmangos/run/etc/mangosd.conf
Restart=on-failure
RestartSec=15
TimeoutStopSec=300
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
