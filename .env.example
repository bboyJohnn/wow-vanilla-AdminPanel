# WoW Web Panel settings. Copy this file to .env next to panel.py and fill in the REQUIRED part:
#   cp .env.example .env && chmod 600 .env
# A value may refer to a key above it: ${WOW_DIR}/etc/mangosd.conf. Text after " #" is a comment.
# Check everything with:  python3 panel.py --check

# ============================================================== REQUIRED

# Your mangosd.conf. The panel reads from it the database connections (LoginDatabaseInfo,
# CharacterDatabaseInfo, WorldDatabaseInfo), SOAP.IP / SOAP.Port, RealmID, DataDir and LogsDir —
# so usually nothing else about the server has to be set here.
WOW_MANGOSD_CONF=/home/wow/cmangos/run/etc/mangosd.conf

# Panel login password (scrypt hash) and the key that signs login cookies.
# Do not write them by hand — run:  python3 tools/passwd.py
PANEL_PASSWORD_HASH=
PANEL_SECRET=

# Game account the panel sends commands through (SOAP). It needs GM level 3.
# Create it in the mangosd console:  account create WEBPANEL <password>  then  account set gmlevel WEBPANEL 3
SOAP_USER=WEBPANEL
SOAP_PASS=

# ============================================================== NETWORK

# Where the panel listens. 127.0.0.1 = only this machine (open it through an SSH tunnel or a reverse proxy).
PANEL_HOST=127.0.0.1
PANEL_PORT=8090
# Who may connect at all (before the password): addresses and networks, comma separated.
# Behind nginx on the same machine keep 127.0.0.1. For a home network: 127.0.0.1,::1,192.168.0.0/24
PANEL_ALLOWED_PEERS=127.0.0.1,::1

# ============================================================== LOOK

PANEL_TITLE=WoW Server           # name in the menu, on the login screen and in the browser tab
PANEL_ADDRESS=                   # shown under the menu, e.g. logon.example.com
PANEL_HUB=                       # optional "All panels" link: a URL, or :8089 (same host, other port)

# ============================================================== OPTIONAL OVERRIDES
# Leave empty to take the value from mangosd.conf / the defaults shown.

# Database: one user that can read and write all three databases (the core's own user is fine).
DB_HOST=                         # host from LoginDatabaseInfo; "." means a unix socket, path in DB_PORT
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_REALMD=                       # classicrealmd
DB_CHARS=                        # classiccharacters
DB_WORLD=                        # classicmangos
REALM_ID=                        # RealmID from mangosd.conf

# SOAP address (SOAP.IP / SOAP.Port from mangosd.conf; 0.0.0.0 becomes 127.0.0.1)
SOAP_HOST=
SOAP_PORT=

# Folders of the server. WOW_DIR is the folder with bin/ and etc/ (default: two levels above mangosd.conf).
WOW_DIR=
WOW_BIN=                         # ${WOW_DIR}/bin — where mangosd runs; relative DataDir/LogsDir start here
WOW_REALMD_CONF=                 # realmd.conf next to mangosd.conf — only to find Realmd.log
WOW_DATA=                        # DataDir from mangosd.conf: dbc/, maps/, vmaps/…
WOW_DBC=                         # ${WOW_DATA}/dbc — names of zones, spells, icons, talents
WOW_MAPS=                        # ${WOW_DATA}/maps — ground height for the map teleport
WOW_LOGS=                        # LogsDir from mangosd.conf (empty there = WOW_BIN)
WOW_CHAR_LOG=                    # ${WOW_LOGS}/Char.log — character sessions
WOW_CONF_BACKUPS=                # where copies of mangosd.conf go before every save (etc/backups)
WOW_PLAYERBOT_CONF=              # etc/aiplayerbot.conf — the Bots page appears only if it exists
WOW_AHBOT_CONF=                  # etc/ahbot.conf

# Panel's own data: history, audit log, restart schedule, copies of custom items/NPCs/quests.
PANEL_DATA=                      # ./data
# Country by IP: GeoLite2-Country.mmdb (free from MaxMind). Without it countries are simply not shown.
GEOIP_DB=                        # ./data/GeoLite2-Country.mmdb

# Extra log files for the Logs page: Label=/path/file.log, comma separated.
PANEL_LOGS=
# Processes shown on the Overview: name:process[:script], comma separated; several process names with "|",
# "self" = the panel itself. Remove "mariadb" if the database runs on another machine.
PANEL_SERVICES=mariadb:mariadbd|mysqld,realmd:realmd,mangosd:mangosd,panel:self
# Services the panel may restart by stopping the process (SIGTERM). Only list a service here if something
# starts it again — systemd with Restart=always (see deploy/cmangos-realm.service). The world is always
# restarted through ".server restart", never killed.
PANEL_KILLABLE=
